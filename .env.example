DJANGO_TIME_ZONE=Africa/Lubumbashi
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# --- Base de donnÃ©es --------------------------------------------
# DÃ©veloppement : SQLite par dÃ©faut (aucune configuration nÃ©cessaire).
# Production : passer DJANGO_USE_POSTGRES=True et renseigner POSTGRES_*.
DJANGO_USE_POSTGRES=False
DJANGO_DB_ENGINE=django.db.backends.sqlite3
POSTGRES_DB=citedelamisericorde
POSTGRES_USER=cite
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

