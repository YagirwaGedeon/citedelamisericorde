# --- Django -------------------------------------------------
DJANGO_SECRET_KEY=change-me-please
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8765,http://127.0.0.1:8765
